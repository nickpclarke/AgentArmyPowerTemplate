@prefix gufo: <http://purl.org/nemo/gufo#> .

<https://agentarmy.dev/self> a owl:Ontology .

:SystemComponent a owl:Class ;
    rdfs:subClassOf gufo:Category ;
    rdfs:label "SystemComponent" ;
    rdfs:comment "An identifiable element of the platform that can be positioned on a value chain and an evolution axis." .

:Repository a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Repository" ;
    rdfs:comment "A version-controlled code corpus that is independently deployable or templated." .

:HubRepository a owl:Class ;
    rdfs:subClassOf gufo:SubKind ;
    rdfs:subClassOf :Repository ;
    rdfs:label "HubRepository" ;
    rdfs:comment "The template/orchestration repository that owns the inter-layer contract surface and the platform tier." .

:SpokeRepository a owl:Class ;
    rdfs:subClassOf gufo:SubKind ;
    rdfs:subClassOf :Repository ;
    rdfs:label "SpokeRepository" ;
    rdfs:comment "A layer repository generated from the hub that implements one layer of the system." .

:Container a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Container" ;
    rdfs:comment "A deployable image belonging to exactly one tier (ARC-ADR-023)." .

:PlatformContainer a owl:Class ;
    rdfs:subClassOf gufo:SubKind ;
    rdfs:subClassOf :Container ;
    rdfs:label "PlatformContainer" ;
    rdfs:comment "Stateful, slow-lifecycle container (database, broker, triplestore)." .

:ApplicationContainer a owl:Class ;
    rdfs:subClassOf gufo:SubKind ;
    rdfs:subClassOf :Container ;
    rdfs:label "ApplicationContainer" ;
    rdfs:comment "Stateless one-per-spoke application container with rolling deploys." .

:FunctionContainer a owl:Class ;
    rdfs:subClassOf gufo:SubKind ;
    rdfs:subClassOf :Container ;
    rdfs:label "FunctionContainer" ;
    rdfs:comment "Small, stateless, independently rolled-out single-purpose container." .

:Contract a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Contract" ;
    rdfs:comment "A versioned inter-layer interface specification a producer publishes and consumers bind to." .

:Platform a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Platform" ;
    rdfs:comment "An external infrastructure or SaaS capability the fleet runs on or calls." .

:ExternalOrganization a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:label "ExternalOrganization" ;
    rdfs:comment "An external organization the project depends on, partners with, or integrates." .

:Agent a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Agent" ;
    rdfs:comment "A specialist AI agent definition that performs scoped work in the fleet." .

:Army a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Army" ;
    rdfs:comment "A coordinated collective of agents operating under one execution model (Claude Code or Copilot)." .

:ArchitecturalDecision a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:label "ArchitecturalDecision" ;
    rdfs:comment "A recorded architecture decision (ADR) that fixes a design choice and its consequences." .

:Capability a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Capability" ;
    rdfs:comment "A business/platform capability the system provides, independent of how it is implemented." .

:Surface a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:subClassOf :SystemComponent ;
    rdfs:label "Surface" ;
    rdfs:comment "A user-experience space (a product/ops surface, e.g. Crucible) through which one or more platform capabilities are interfaced. The 'noun/place' you interact with; the capability is the 'verb' it exposes (untool product ontology: Crucible/Refinery/Registry/Workspace/Fleet-Console)." .

:ReleaseTrain a owl:Class ;
    rdfs:subClassOf gufo:Kind ;
    rdfs:label "ReleaseTrain" ;
    rdfs:comment "A SAFE release train: a strategic theme grouping features over program increments." .

:contract_binding a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that a producer repo publishes a contract that one or more consumer repos bind to, with a status over time. The typed form of docs/contracts.md." .

:deployment a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that a container is deployed onto a platform in an environment." .

:governed_by_decision a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that an architecture decision governs one or more system components (its blast radius)." .

:partner_engagement a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that an external organization partners with the project regarding a platform/capability, optionally via a contract." .

:capability_realization a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that a platform capability is realised by one or more system components (repos, containers, platforms, armies)." .

:capability_exposure a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that a Surface (UX space, e.g. Crucible) exposes one or more Capabilities to a user. The surface is where you interface with the capability; the capability is the verb the surface fronts." .

:release_delivery a owl:Class ; rdfs:subClassOf gufo:Relator ;
    rdfs:comment "Reifies that a SAFE release train delivers one or more system components (capabilities, repos, contracts)." .

