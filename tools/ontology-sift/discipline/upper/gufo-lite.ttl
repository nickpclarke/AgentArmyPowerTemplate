@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/bfo#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# gUFO-lite — a deliberately tiny slice of gUFO for the sift doctor (NOT full gUFO,
# which is vendored/pinned from nemo-ufes for the real pipeline). It carries just
# enough to (a) place every stereotype under Endurant/Event and (b) bridge to BFO
# so the L3 reasoner can cross-check the two classifications. ARC-ADR-032.

gufo:Endurant  a owl:Class .
gufo:Event     a owl:Class .
gufo:Situation a owl:Class .

gufo:Relator  a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Kind     a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:SubKind  a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Role     a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Phase    a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Category a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Mixin    a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Quality  a owl:Class ; rdfs:subClassOf gufo:Endurant .
gufo:Mode     a owl:Class ; rdfs:subClassOf gufo:Endurant .

gufo:mediates a owl:ObjectProperty ; rdfs:domain gufo:Relator .

# The dual-grounding bridge: gUFO endurants ARE BFO continuants; gUFO events/
# situations ARE BFO occurrents. This is what makes the two classifications
# cross-checkable — a candidate whose gUFO and BFO types disagree becomes
# inconsistent under the reasoner (L3), not merely "implausible".
gufo:Endurant  rdfs:subClassOf bfo:Continuant .
gufo:Event     rdfs:subClassOf bfo:Occurrent .
gufo:Situation rdfs:subClassOf bfo:Occurrent .
