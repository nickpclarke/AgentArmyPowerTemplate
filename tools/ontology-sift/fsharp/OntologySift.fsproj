<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- FS0025 (incomplete pattern match) as a BUILD ERROR: a projection out of the
         stereotype coproduct with a missing case cannot be shipped. This is the
         "snapped, not plausible" guarantee enforced by the compiler (ARC-ADR-033). -->
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Compile order matters in F#: the IR before the functor before the sift. -->
  <ItemGroup>
    <Compile Include="Ir.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="Sift.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
