{
  "$comment": "Manifest for the versioned fleet contract bundle (ARC-ADR-034). The single source of truth for what spokes pin + codegen from. `node tools/contracts-package.mjs` gathers each artifact FROM ITS PRODUCER repo (hub or a sibling spoke), packages them as ONE OCI artifact, and pushes it to GHCR (cosign-signed) via ORAS. This bundle REPLACES the hand-copied vendoring (e.g. backend-core.openapi.json copied into frontend-core, agui-stream duplicated, fleet-interface/ vendored 3×) — consumers pull one pinned version instead. Mirrors the 'shipped' rows of docs/contracts.md; add a row as each backlog contract ships. siblingRoot: where the spoke checkouts live relative to the hub (default = the hub's parent dir; CI checks the spokes out there or uses the ARC-ADR-034 read token).",
  "registry": "ghcr.io/nickpclarke/contracts",
  "version": "0.1.0",
  "artifactType": "application/vnd.agentarmy.contracts.bundle.v1+json",
  "siblingRoot": "..",
  "$check": "`--check` enumerates contract files under `scan` roots (by type) across every repo, subtracts `artifacts` (bundled) + `exclude` (deliberately not bundled: vendored copies, derived, drafts, tests), and fails if any source contract is left un-bundled — so a newly-minted contract can't silently escape the bundle.",
  "scan": {
    "hub": ["contracts", "templates/ontology-project"],
    "backend-core": ["contracts", "app/ontology/discipline/midlevel"],
    "middle-core": ["contracts"],
    "frontend-core": ["contract"]
  },
  "scanTypes": ["*.openapi.json", "*.openapi.yaml", "*.asyncapi.yaml", "*.ttl", "*.schema.json"],
  "exclude": [
    "**/proposed/**",
    "**/tests/**",
    "**/fixtures/**",
    "**/fleet-interface/**",
    "frontend-core/contract/backend-core.openapi.json",
    "frontend-core/contract/agui-stream.asyncapi.yaml",
    "frontend-core/contract/components/**",
    "hub/contracts/llm-gateway.openapi.yaml"
  ],
  "artifacts": [
    { "repo": "hub", "path": "contracts/health.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "hub", "path": "contracts/problem-details.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "hub", "path": "contracts/forge-control.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "hub", "path": "contracts/webhook-receiver.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "hub", "path": "contracts/platform-update-subscription.schema.json", "mediaType": "application/schema+json" },
    { "repo": "hub", "path": "contracts/platform-update-cloudevent.schema.json", "mediaType": "application/schema+json" },
    { "repo": "hub", "path": "contracts/runbook-orchestrator.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "hub", "path": "templates/ontology-project/ontology.ir.schema.json", "mediaType": "application/schema+json" },
    { "repo": "hub", "path": "templates/ontology-project/constraints/model.shacl.ttl", "mediaType": "text/turtle" },
    { "repo": "hub", "path": "templates/ontology-project/semantic/model.gufo.ttl", "mediaType": "text/turtle" },
    { "repo": "hub", "path": "templates/ontology-project/semantic/model.bfo-cco.ttl", "mediaType": "text/turtle" },

    { "repo": "backend-core", "path": "contracts/backend-core.openapi.json", "mediaType": "application/vnd.oai.openapi+json" },
    { "repo": "backend-core", "path": "contracts/agentarmy-platform.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "backend-core", "path": "contracts/agent-gateway.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "backend-core", "path": "contracts/llm-gateway.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "backend-core", "path": "contracts/tavily-upstream.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },
    { "repo": "backend-core", "path": "app/ontology/discipline/midlevel/api-interface.ttl", "mediaType": "text/turtle" },
    { "repo": "backend-core", "path": "app/ontology/discipline/midlevel/board.ttl", "mediaType": "text/turtle" },
    { "repo": "backend-core", "path": "app/ontology/discipline/midlevel/business-mid.ttl", "mediaType": "text/turtle" },
    { "repo": "backend-core", "path": "app/ontology/discipline/midlevel/workitem-fields.ttl", "mediaType": "text/turtle" },

    { "repo": "middle-core", "path": "contracts/agui-stream.asyncapi.yaml", "mediaType": "application/vnd.aai.asyncapi+yaml" },
    { "repo": "middle-core", "path": "contracts/proposed/mcr-f4-projection.openapi.yaml", "mediaType": "application/vnd.oai.openapi+yaml" },

    { "repo": "frontend-core", "path": "contract/frontend-bff.openapi.json", "mediaType": "application/vnd.oai.openapi+json" },
    { "repo": "frontend-core", "path": "contract/design-tokens.json", "mediaType": "application/json" },
    { "repo": "frontend-core", "path": "contract/design-tokens.schema.json", "mediaType": "application/schema+json" }
  ]
}
