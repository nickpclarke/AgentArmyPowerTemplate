# Copy to `.env` (gitignored) OR `export GH_PAT=...` in your shell before `docker compose up`.
# Classic GitHub PAT with `repo` scope (needed to register runners on PRIVATE repos).
# Reuse your existing PROJECT_TOKEN-style PAT, or mint a dedicated one at:
#   https://github.com/settings/tokens  (classic, scope: repo)
GH_PAT=
