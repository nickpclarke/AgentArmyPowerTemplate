@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix forge: <http://agentarmy.dev/forge#> .
@prefix ex:    <http://example.org/onto#> .

# Model header — one and only one forge:Model in the graph.
[] a forge:Model ;
   forge:version "1.0.0" ;
   forge:namespace "AgentArmy.MiddleCore.Contracts" .

# ---------------------------------------------------------------------------
# ObjectType: User
# ---------------------------------------------------------------------------
ex:User a owl:Class ;
    rdfs:label "Platform user" ;
    forge:fieldOrder ( "id" "handle" "createdAt" ) ;
    forge:relationOrder ( "documents" ) .

ex:User__id a owl:DatatypeProperty ;
    rdfs:domain ex:User ;
    rdfs:range  forge:uuid .
ex:User__handle a owl:DatatypeProperty ;
    rdfs:domain ex:User ;
    rdfs:range  xsd:string .
ex:User__createdAt a owl:DatatypeProperty ;
    rdfs:domain ex:User ;
    rdfs:range  xsd:dateTime .

ex:User__documents a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:Document ;
    forge:cardinality "many" .

# ---------------------------------------------------------------------------
# ObjectType: Document
# ---------------------------------------------------------------------------
ex:Document a owl:Class ;
    rdfs:label "Knowledge document" ;
    forge:fieldOrder ( "id" "title" "body" "wordCount" "createdAt" ) ;
    forge:relationOrder ( "author" ) .

ex:Document__id a owl:DatatypeProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  forge:uuid .
ex:Document__title a owl:DatatypeProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  xsd:string .
ex:Document__body a owl:DatatypeProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  xsd:string ;
    forge:optional true .
ex:Document__wordCount a owl:DatatypeProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  xsd:integer .
ex:Document__createdAt a owl:DatatypeProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  xsd:dateTime .

ex:Document__author a owl:ObjectProperty ;
    rdfs:domain ex:Document ;
    rdfs:range  ex:User ;
    forge:cardinality "one" ;
    forge:inverse "documents" .
