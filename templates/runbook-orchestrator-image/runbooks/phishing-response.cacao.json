{
  "type": "playbook",
  "spec_version": "cacao-2.0",
  "id": "playbook--a1b2c3d4-0000-4abc-8def-000000000000",
  "name": "Phishing Email Response",
  "description": "Fan out notify + investigate, then conditionally contain. Exercises parallel, manual (HITL), emit-event, and an if-condition. Triggered by a SIEM phishing event.",
  "playbook_types": ["investigation", "mitigation"],
  "created_by": "identity--351b1469-64b4-4778-8d93-f7949a88990d",
  "created": "2026-05-28T00:00:00.000Z",
  "modified": "2026-05-28T00:00:00.000Z",
  "workflow_start": "start--a1b2c3d4-0001-4abc-8def-000000000001",
  "workflow": {
    "start--a1b2c3d4-0001-4abc-8def-000000000001": {
      "type": "start",
      "description": "Begin on a SIEM phishing alert.",
      "on_completion": "parallel--a1b2c3d4-0002-4abc-8def-000000000002",
      "step_extensions": {
        "trigger": { "kind": "message", "subject": "fleet.siem.phishing" }
      }
    },
    "parallel--a1b2c3d4-0002-4abc-8def-000000000002": {
      "type": "parallel",
      "name": "Notify and investigate concurrently",
      "next_steps": [
        "action--a1b2c3d4-0003-4abc-8def-000000000003",
        "action--a1b2c3d4-0004-4abc-8def-000000000004"
      ],
      "on_completion": "if-condition--a1b2c3d4-0005-4abc-8def-000000000005"
    },
    "action--a1b2c3d4-0003-4abc-8def-000000000003": {
      "type": "action",
      "name": "Notify SOC channel",
      "commands": [
        { "type": "http-api", "command": "POST /alerts" }
      ],
      "agent": "organization--a1b2c3d4-0010-4abc-8def-000000000010",
      "targets": ["http-api--a1b2c3d4-0020-4abc-8def-000000000020"],
      "on_completion": "if-condition--a1b2c3d4-0005-4abc-8def-000000000005"
    },
    "action--a1b2c3d4-0004-4abc-8def-000000000004": {
      "type": "action",
      "name": "Analyst triages the email (manual)",
      "commands": [
        { "type": "manual", "command": "Review headers + detonate attachment in sandbox; set severity." }
      ],
      "agent": "organization--a1b2c3d4-0010-4abc-8def-000000000010",
      "on_completion": "if-condition--a1b2c3d4-0005-4abc-8def-000000000005"
    },
    "if-condition--a1b2c3d4-0005-4abc-8def-000000000005": {
      "type": "if-condition",
      "name": "Is severity high?",
      "condition": "__severity__:value = 'high'",
      "on_true": "action--a1b2c3d4-0006-4abc-8def-000000000006",
      "on_false": "end--a1b2c3d4-0007-4abc-8def-000000000007"
    },
    "action--a1b2c3d4-0006-4abc-8def-000000000006": {
      "type": "action",
      "name": "Quarantine mailbox",
      "commands": [
        { "type": "ssh", "command": "quarantine --mailbox $user --reason phishing" }
      ],
      "agent": "organization--a1b2c3d4-0010-4abc-8def-000000000010",
      "targets": ["security-category--a1b2c3d4-0021-4abc-8def-000000000021"],
      "on_completion": "end--a1b2c3d4-0007-4abc-8def-000000000007"
    },
    "end--a1b2c3d4-0007-4abc-8def-000000000007": {
      "type": "end",
      "description": "Response complete."
    }
  },
  "agent_definitions": {
    "organization--a1b2c3d4-0010-4abc-8def-000000000010": {
      "type": "organization",
      "name": "SOC",
      "description": "Security operations centre executing the response."
    }
  },
  "target_definitions": {
    "http-api--a1b2c3d4-0020-4abc-8def-000000000020": {
      "type": "http-api",
      "name": "Alerting API"
    },
    "security-category--a1b2c3d4-0021-4abc-8def-000000000021": {
      "type": "security-category",
      "name": "Mail server",
      "category": ["mail-server"]
    }
  }
}
