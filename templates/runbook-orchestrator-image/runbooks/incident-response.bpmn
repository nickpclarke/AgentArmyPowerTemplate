<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  targetNamespace="http://agentarmy.dev/runbook"
  id="def-incident-response">

  <!-- Inbound trigger: a security alert delivered on the event bus. -->
  <message id="msg-alert" name="SecurityAlertReceived" />

  <process id="proc-incident" name="Incident Response" isExecutable="true">

    <startEvent id="start" name="Alert Received">
      <messageEventDefinition messageRef="msg-alert" />
    </startEvent>

    <serviceTask id="task-analyze" name="Analyze and enrich alert"
                 implementation="##WebService" />

    <exclusiveGateway id="gw-severity" name="Severity?" default="flow-low" />

    <serviceTask id="task-page" name="Page on-call engineer" />
    <endEvent id="end-escalated" name="Escalated" />

    <serviceTask id="task-ticket" name="Log a ticket" />
    <endEvent id="end-logged" name="Logged" />

    <sequenceFlow id="sf-start-analyze" sourceRef="start" targetRef="task-analyze" />
    <sequenceFlow id="sf-analyze-gw" sourceRef="task-analyze" targetRef="gw-severity" />

    <sequenceFlow id="flow-high" sourceRef="gw-severity" targetRef="task-page" name="HIGH">
      <conditionExpression xsi:type="tFormalExpression">${severity == 'HIGH'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-low" sourceRef="gw-severity" targetRef="task-ticket" name="LOW (default)" />

    <sequenceFlow id="sf-page-end" sourceRef="task-page" targetRef="end-escalated" />
    <sequenceFlow id="sf-ticket-end" sourceRef="task-ticket" targetRef="end-logged" />

  </process>
</definitions>
