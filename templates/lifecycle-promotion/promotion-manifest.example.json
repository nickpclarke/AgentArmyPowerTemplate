{
  "schema_version": "agentarmy.promotion.v1",
  "lifecycle_profile": "platform-workload",
  "service": "example-api",
  "default_target": "azure-container-apps",
  "dev_source_ref": "azure-dev",
  "promotion_order": ["local", "dev", "staging", "prod"],
  "simulation_targets": ["mock"],
  "targets": {
    "azure-container-apps": {
      "cloud": "azure",
      "build": "acr-task",
      "runtime": "container-apps",
      "template": "templates/azure-container-apps-dev/"
    },
    "gcp-cloud-run": {
      "cloud": "gcp",
      "build": "cloud-build",
      "runtime": "cloud-run",
      "template": "templates/gcp-cloud-run/"
    },
    "vertex-agent-engine": {
      "cloud": "gcp",
      "build": "cloud-build",
      "runtime": "vertex-ai-agent-engine",
      "template": "templates/vertex-agent-engine/"
    }
  }
}
