# Non-secret knobs for the event-bridge. Copy to .env and edit if needed.
SUBJECT_PREFIX=fleet.gh
STREAM_NAME=FLEET
STREAM_SUBJECTS=fleet.>
PORT=8080
# Replay window for X-GitHub-Delivery dedup (seconds).
REPLAY_TTL_SECONDS=300
# GITHUB_WEBHOOK_SECRET comes from a mounted secret file in compose — DO NOT set here.
