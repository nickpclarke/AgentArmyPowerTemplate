{
  "schema_version": "agentarmy.services.v1",
  "services": [
    {
      "name": "web",
      "kind": "frontend",
      "path": "apps/web",
      "build": "npm run build",
      "test": "npm test",
      "health_url": "http://127.0.0.1:3000",
      "required": false
    },
    {
      "name": "api",
      "kind": "backend",
      "path": "services/api",
      "test": "pytest",
      "health_url": "http://127.0.0.1:8000/health",
      "openapi": "openapi.json",
      "required": false
    }
  ]
}
