# GENERATED from model/model.yaml — do not hand-edit. SHACL shapes (validation Level 4, closed-world).
# Validate data with: pyshacl -s model.shacl.ttl -df turtle <data>.ttl
@prefix ex:  <https://agentarmy.dev/ex/rmp#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:MitigationCaseShape a sh:NodeShape ;
    sh:targetClass ex:MitigationCase ;
    # constraint: mitigated-risk-needs-owner (severity violation)
    sh:property [ sh:path ex:accountableOwner ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:RiskOwner ] ;
    sh:property [ sh:path ex:evidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:EvidenceBundle ] ;
    sh:property [ sh:path ex:mitigatedRisk ; sh:minCount 1 ; sh:class ex:Risk ] ;
    sh:property [ sh:path ex:mitigatingControl ; sh:minCount 1 ; sh:class ex:Control ] ;
    sh:property [ sh:path ex:assembledAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ex:RiskShape a sh:NodeShape ;
    sh:targetClass ex:Risk ;
    sh:property [ sh:path ex:likelihood ; sh:maxCount 1 ;
                  sh:in ( "Rare" "Unlikely" "Possible" "Likely" "AlmostCertain" ) ] .

ex:RiskSeverityShape a sh:NodeShape ;
    sh:targetClass ex:RiskSeverity ;
    sh:property [ sh:path ex:value ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "Low" "Medium" "High" "Critical" ) ] .
