{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentarmy.dev/schemas/ontology.ir.schema.json",
  "title": "AgentArmy Canonical Ontology IR",
  "description": "The single source-of-truth intermediate representation for the ontology-derived generative pipeline. Authored in OntoUML/UFO stereotypes; compiled into many projections (gUFO OWL, BFO/CCO, SHACL, C#, ArcadeDB, PROV-O). This schema is validation Level 1 (syntactic): well-formed model, unique IDs, valid stereotypes. See README.md.",
  "type": "object",
  "required": ["ontology", "types"],
  "additionalProperties": false,
  "properties": {
    "ontology": { "$ref": "#/$defs/ontologyMeta" },
    "types": {
      "type": "array",
      "description": "Object/aspect/event types, each carrying an OntoUML stereotype.",
      "items": { "$ref": "#/$defs/type" }
    },
    "relators": {
      "type": "array",
      "description": "N-ary relationships reified as first-class relators with typed roles (hyperedge-as-vertex). A binary relation is a degenerate 2-role relator.",
      "items": { "$ref": "#/$defs/relator" }
    },
    "relations": {
      "type": "array",
      "description": "Non-reified relations: «material» (derived from a relator), «formal», parthood, «mediation», «characterization».",
      "items": { "$ref": "#/$defs/relation" }
    },
    "constraints": {
      "type": "array",
      "description": "Validation constraints targeting types/relators, expressed for a downstream prover (SHACL/Alloy/SMT/OWL).",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "projections": { "$ref": "#/$defs/projections" }
  },
  "$defs": {
    "stereotype": {
      "type": "string",
      "description": "OntoUML class stereotype. See ufo-ontology skill ONTOUML_PROFILE.md.",
      "enum": [
        "kind", "subkind", "phase", "role",
        "category", "mixin", "roleMixin", "phaseMixin",
        "collective", "quantity",
        "relator", "mode", "quality",
        "event", "situation",
        "type", "datatype", "enumeration"
      ]
    },
    "cardinality": {
      "type": "string",
      "description": "UML-style multiplicity.",
      "pattern": "^(\\*|\\d+)(\\.\\.(\\*|\\d+))?$"
    },
    "id": {
      "type": "string",
      "description": "Stable, model-unique identifier (kebab-case recommended).",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "ontologyMeta": {
      "type": "object",
      "required": ["id", "version", "default_namespace"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "description": "SemVer of the model." },
        "foundation": {
          "type": "string",
          "description": "Primary foundational discipline.",
          "enum": ["UFO/gUFO", "BFO", "none"],
          "default": "UFO/gUFO"
        },
        "default_namespace": { "type": "string", "format": "uri" },
        "imports": {
          "type": "array",
          "description": "Pinned upstream vocabularies (gUFO, SEON, gist, FIBO, OWL-Time, PROV-O, SOSA, DCAT, BFO, CCO...).",
          "items": {
            "type": "object",
            "required": ["prefix", "uri"],
            "additionalProperties": false,
            "properties": {
              "prefix": { "type": "string" },
              "uri": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Per-element provenance (PROV-O). Drives the provenance projection + bitemporal stamping.",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "description": "Where this element came from (SME, doc, source model id)." },
        "derived_from": { "type": "string" },
        "generated_by": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "property": {
      "type": "object",
      "required": ["id", "range"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "range": { "type": "string", "description": "Datatype or type id (e.g. string, integer, SeverityLevel)." },
        "cardinality": { "$ref": "#/$defs/cardinality", "default": "0..1" },
        "description": { "type": "string" }
      }
    },
    "type": {
      "type": "object",
      "required": ["id", "stereotype"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stereotype": { "$ref": "#/$defs/stereotype" },
        "parent": { "type": "string", "description": "id of the supertype this specializes (subkind/phase/role inherit a kind's identity)." },
        "description": { "type": "string", "description": "Aristotelian definition (genus + differentia)." },
        "gufo_type": { "type": "string", "description": "gUFO type class for the OWL projection, e.g. gufo:Kind." },
        "bfo_class": { "type": "string", "description": "BFO/CCO target for the realist projection, e.g. obo:BFO_0000030 or cco:Person. Best-effort; record divergences in docs/mapping-rules.md." },
        "identity": {
          "type": "string",
          "description": "Identity meta-kind for sortals.",
          "enum": ["functional-complex", "collective", "quantity", "inherited", "none"]
        },
        "rigidity": {
          "type": "string",
          "enum": ["rigid", "anti-rigid", "semi-rigid"]
        },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "literals": {
          "type": "array",
          "description": "For «enumeration» types: the enumerated literals.",
          "items": { "type": "string" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "participant_type", "cardinality"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "participant_type": { "type": "string", "description": "id of a type that fills this role." },
        "cardinality": { "$ref": "#/$defs/cardinality" },
        "description": { "type": "string" }
      }
    },
    "relator": {
      "type": "object",
      "required": ["id", "roles"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stereotype": { "const": "relator" },
        "description": { "type": "string" },
        "roles": {
          "type": "array",
          "description": "Typed role bindings. Keep role types disjoint (avoid the RelOver anti-pattern).",
          "minItems": 2,
          "items": { "$ref": "#/$defs/role" }
        },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "temporal": {
          "type": "object",
          "description": "Bitemporal validity carried ON the relator (valid time + transaction time).",
          "additionalProperties": false,
          "properties": {
            "valid_from": { "type": "string" },
            "valid_to": { "type": "string" },
            "recorded_at": { "type": "string" }
          }
        },
        "bfo_pattern": {
          "type": "string",
          "description": "How this relator projects to BFO (it has no single counterpart). See bfo-ontology skill.",
          "enum": ["relational-quality", "interdependent-roles", "process-plus-ice"]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "stereotype", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stereotype": {
          "type": "string",
          "enum": ["material", "formal", "mediation", "characterization", "componentOf", "memberOf", "subCollectionOf", "subQuantityOf", "participation"]
        },
        "source": { "type": "string", "description": "id of the source type/relator." },
        "target": { "type": "string", "description": "id of the target type." },
        "derived_from": { "type": "string", "description": "For «material» relations: the relator id this is derived from." },
        "source_cardinality": { "$ref": "#/$defs/cardinality" },
        "target_cardinality": { "$ref": "#/$defs/cardinality" }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["id", "language", "target", "expression"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "language": {
          "type": "string",
          "enum": ["shacl", "shex", "alloy", "smt", "owl"]
        },
        "severity": {
          "type": "string",
          "enum": ["violation", "warning", "info"],
          "default": "violation"
        },
        "target": { "type": "string", "description": "id of the type/relator the constraint applies to." },
        "expression": { "type": "string", "description": "Human-readable rule; the generator emits the language-specific form." }
      }
    },
    "projections": {
      "type": "object",
      "description": "Which projections the generator emits from this IR. Each is a separate representation — never collapse them.",
      "additionalProperties": false,
      "properties": {
        "gufo": { "type": "boolean", "default": true, "description": "gUFO OWL (Level-3 reasoner target) — primary." },
        "bfo_cco": { "type": "boolean", "default": false, "description": "BFO 2020 + CCO realist sidecar — interop projection." },
        "owl": { "type": "boolean", "default": true },
        "shacl": { "type": "boolean", "default": true, "description": "Closed-world constraints (Level 4)." },
        "alloy": { "type": "boolean", "default": false, "description": "Finite-scope simulation (Level 5)." },
        "smt": { "type": "boolean", "default": false, "description": "Arithmetic/temporal proofs (Level 6)." },
        "csharp": { "type": "boolean", "default": false, "description": "Deterministic generated C# hypergraph runtime." },
        "arcadedb": { "type": "boolean", "default": false, "description": "Hyperedge-as-vertex persistence schema." },
        "prov": { "type": "boolean", "default": true, "description": "PROV-O + hashable manifest." },
        "dlt_anchor": { "type": "boolean", "default": false, "description": "Anchor only hashes/manifests, never the graph." }
      }
    }
  }
}
