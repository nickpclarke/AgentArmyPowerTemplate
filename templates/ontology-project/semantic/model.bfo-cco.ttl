# GENERATED from model/model.yaml — do not hand-edit. BFO 2020 + CCO realist projection (interop sidecar).
# BEST-EFFORT, NOT a lossless round-trip — divergences recorded in ../docs/mapping-rules.md.
# This is what a BFO consumer (e.g. IKW-GraphEngine: BFO 2020 CL + CCO + Guan) reasons over.
@prefix ex:   <https://agentarmy.dev/ex/rmp#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex: a owl:Ontology .

# --- Clean alignments ---
ex:Person         rdfs:subClassOf cco:Person .          # cco:Person ⊑ BFO:object (independent continuant)
ex:EvidenceBundle rdfs:subClassOf obo:IAO_0000030 .     # information content entity (generically dependent continuant)
ex:Control        rdfs:subClassOf obo:BFO_0000031 .     # GDC-ish (a specified plan/measure) OR cco:Act per use; see mapping notes
ex:RiskSeverity   rdfs:subClassOf obo:BFO_0000019 .     # quality

# --- Role: UFO role-as-type becomes a BFO role (realizable entity) BORNE BY the person ---
ex:RiskOwnerRole  rdfs:subClassOf obo:BFO_0000023 .     # role
ex:RiskOwnerRole  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:RO_0000052 ; owl:someValuesFrom ex:Person ] .  # inheres in

# --- Relator: NO single BFO counterpart. bfo_pattern=interdependent-roles ---
#     mitigation-case -> a Process that realizes a bundle of roles inhering in the participants.
ex:MitigationProcess rdfs:subClassOf obo:BFO_0000015 .  # process
ex:MitigationProcess rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty obo:RO_0000057 ; owl:someValuesFrom ex:Person ] ,    # has participant
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom ex:RiskOwnerRole ] . # realizes
# Risk (no clean BFO home — disposition vs role) projected as a disposition borne by the risk-bearer:
ex:Risk           rdfs:subClassOf obo:BFO_0000016 .     # disposition  [DIVERGENCE — see mapping-rules.md]
