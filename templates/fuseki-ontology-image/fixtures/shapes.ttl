@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <https://example.org/> .

# Minimal demo shape used by the doctor: a Person must have exactly one ex:name
# (a string). Real fleet shapes are mounted at /shapes (bring-your-own).
ex:PersonShape
    a            sh:NodeShape ;
    sh:targetClass  ex:Person ;
    sh:property  [
        sh:path     ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
