# Non-secret knobs for the AgentArmy ArcadeDB image. Copy to .env (gitignored).
# Secrets are NOT set here — mount them as files and point the *_FILE vars at them
# (see examples/compose.arcadedb-server.example.yml and docs/arcadedb-secret-hardening.md).

ARCADEDB_DATABASE=knowledge
ARCADEDB_SERVICE_USER=platform_reader
ARCADEDB_HTTP_PORT=2480
ARCADEDB_SERVER_MODE=production

# Heap sizing (container-aware by default). Uncomment to pin an explicit heap:
# ARCADEDB_OPTS_MEMORY=-Xms1G -Xmx1G

# Extra ArcadeDB -D settings, space-separated (optional):
# ARCADEDB_EXTRA_SETTINGS=-Darcadedb.server.httpsIncomingPort=2490

# --- Secret env vars (DO NOT put values here) -------------------------------
# Server-side (consumed by THIS image's entrypoint):
#   ARCADEDB_ROOT_PASSWORD_FILE=/run/secrets/arcadedb_root_password
#   ARCADEDB_SERVICE_PASSWORD_FILE=/run/secrets/arcadedb_password
# Client-side (consumed by tools/agentarmy-doctor.mjs and the cockpit):
#   ARCADEDB_PASSWORD_FILE=/run/secrets/arcadedb_password
# MCP client (consumed by .mcp.json). setup.sh / setup.ps1 generate these into
# examples/.secrets/mcp-client.env. Pick ONE auth header in .mcp.json:
#   ARCADEDB_MCP_URL=http://localhost:2480/api/v1/mcp
#   ARCADEDB_MCP_BASIC=<base64(platform_reader:password)>   # turnkey, no Studio step
#   ARCADEDB_MCP_TOKEN=<bearer token from ArcadeDB Studio -> Security>   # hardened alt
