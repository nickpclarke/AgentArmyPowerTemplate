<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.0.9" />
  </ItemGroup>

  <!-- The xUnit test project lives under MiddleCore.Tests/; keep its sources out
       of this web project's default compile glob (it has its own .csproj). -->
  <ItemGroup>
    <Compile Remove="MiddleCore.Tests/**/*.cs" />
    <Content Remove="MiddleCore.Tests/**/*" />
  </ItemGroup>
</Project>
