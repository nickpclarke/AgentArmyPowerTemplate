{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentarmy.dev/contracts/platform-update-cloudevent.schema.json",
  "title": "AgentArmy Platform Update CloudEvent",
  "description": "CloudEvents v1.0 subset accepted by the platform.messaging.update-system NATS-to-webhook projector.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "additionalProperties": true,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "pattern": "^(platform\\.(capability|adoption|hvfs|security)|fleet\\.agent)\\.[A-Za-z0-9_.-]+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^(platform\\.(capability|adoption|hvfs|security)|fleet\\.agent)\\.[A-Za-z0-9_.-]+$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "type": "string",
      "enum": ["application/json", "application/cloudevents+json"]
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "data": {
      "type": "object"
    }
  }
}
