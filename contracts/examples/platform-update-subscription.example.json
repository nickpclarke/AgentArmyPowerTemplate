{
  "capabilityId": "platform.messaging.update-system",
  "subscriptions": [
    {
      "id": "capability-watchdog",
      "active": true,
      "subjects": ["platform.capability.changed.v1"],
      "filters": {
        "eventTypes": ["platform.capability.changed.v1"],
        "dataEquals": {
          "capabilityId": "platform.messaging.update-system"
        }
      },
      "sink": {
        "url": "https://subscriber.example.com/platform-updates",
        "auth": {
          "type": "hmac-sha256",
          "secretRef": "akv://agentarmy/subscriptions/capability-watchdog-hmac",
          "keyId": "capability-watchdog-v1"
        }
      },
      "replayable": true
    },
    {
      "id": "fleet-console-security",
      "active": true,
      "subjects": ["platform.security.alert.v1"],
      "filters": {
        "eventTypes": ["platform.security.alert.v1"]
      },
      "sink": {
        "url": "https://fleet-console.example.com/security/events",
        "auth": {
          "type": "cloudflare-access-service-token",
          "clientIdSecretRef": "akv://agentarmy/subscriptions/fleet-console-cf-client-id",
          "clientSecretSecretRef": "akv://agentarmy/subscriptions/fleet-console-cf-client-secret"
        }
      },
      "replayable": true,
      "securityTrusted": true
    },
    {
      "id": "paused-adoption-sink",
      "active": false,
      "subjects": ["platform.adoption.changed.v1"],
      "filters": {
        "eventTypes": ["platform.adoption.changed.v1"]
      },
      "sink": {
        "url": "https://subscriber.example.com/paused",
        "auth": {
          "type": "hmac-sha256",
          "secretRef": "akv://agentarmy/subscriptions/paused-hmac"
        }
      }
    }
  ]
}
