@prefix mc: <https://agentarmy.dev/ontology/middle-core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

mc:TopLevelOntology a owl:Ontology ;
  rdfs:label "Middle-core UFO-lite top-level ontology" ;
  rdfs:comment "Prototype UFO/gUFO-aligned upper model for middle-core business objects, state machines, and scenario evidence." .

mc:BusinessObjectKind a gufo:Kind ;
  rdfs:label "Business object kind" .

mc:LifecycleState a gufo:SubKind ;
  rdfs:label "Lifecycle state" ;
  rdfs:comment "A named state that classifies a business object during a bounded portion of its lifecycle." .

mc:StateTransition a gufo:EventType ;
  rdfs:label "State transition" ;
  rdfs:comment "An event type that changes a business object from one lifecycle state to another." .

mc:ScenarioExecution a gufo:EventType ;
  rdfs:label "Scenario execution" .

mc:EvidenceBundle a gufo:Kind ;
  rdfs:label "Evidence bundle" .

mc:CapabilityObservation a gufo:Kind ;
  rdfs:label "Capability observation" .

mc:SemanticAsset a gufo:Kind ;
  rdfs:label "Semantic asset" .

mc:GovernedDecision a gufo:Kind ;
  rdfs:label "Governed decision" .
