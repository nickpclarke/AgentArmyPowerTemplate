@prefix mc: <https://agentarmy.local/middle-core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

mc:SemanticAsset a rdfs:Class ;
  rdfs:label "Semantic Asset" .

mc:CapabilityObservation a rdfs:Class ;
  rdfs:label "Capability Observation" .

mc:EvidenceBundle a rdfs:Class ;
  rdfs:label "Evidence Bundle" .

mc:ActorIntent a rdfs:Class ;
  rdfs:label "Actor Intent" .

mc:GovernedDecision a rdfs:Class ;
  rdfs:label "Governed Decision" .

mc:ScenarioContract a rdfs:Class ;
  rdfs:label "Scenario Contract" .

mc:ToolCandidate a rdfs:Class ;
  rdfs:label "Tool Candidate" .
