filters:
  and:
    - file.hasTag("vision")
properties:
  file.folder:
    displayName: Folder
  track:
    displayName: Track
  file.links:
    displayName: Relates to
  file.backlinks:
    displayName: Used by
views:
  - type: cards
    name: Vision cards
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - track
      - file.links
  - type: table
    name: Vision table
    order:
      - file.name
      - file.folder
      - track
      - file.links
      - file.backlinks
