filters:
  and:
    - file.hasTag("platform")
properties:
  layer:
    displayName: Layer
  track:
    displayName: Track
  file.folder:
    displayName: Folder
  file.links:
    displayName: Relates to
views:
  - type: table
    name: Platform map
    groupBy:
      property: layer
      direction: ASC
    order:
      - file.name
      - layer
      - track
      - file.folder
      - file.links
  - type: cards
    name: Cards
    groupBy:
      property: layer
      direction: ASC
    order:
      - file.name
      - layer
      - file.links
