{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/mempalace_hook.py --hook session-start --harness claude-code",
            "timeout": 30,
            "statusMessage": "Loading memories from MemPalace..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/mempalace_hook.py --hook user-prompt-submit --harness claude-code",
            "timeout": 10,
            "statusMessage": "Enriching prompt with MemPalace context..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/mempalace_hook.py --hook pre-tool-use --harness claude-code",
            "timeout": 10,
            "statusMessage": "Pre-tool MemPalace check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 mempalace hook run --hook post-tool-use --harness claude-code",
            "timeout": 10,
            "statusMessage": "Post-tool MemPalace update..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 mempalace hook run --hook stop --harness claude-code",
            "timeout": 60,
            "statusMessage": "Saving memories to MemPalace..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 mempalace hook run --hook precompact --harness claude-code",
            "timeout": 60,
            "statusMessage": "Emergency save to MemPalace before compaction..."
          }
        ]
      }
    ]
  }
}
