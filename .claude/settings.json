{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/mempalace_hook.py\" --hook session-start --harness claude-code",
            "timeout": 30,
            "statusMessage": "Loading memories from MemPalace..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-dotnet.sh\"",
            "timeout": 300,
            "statusMessage": "Installing .NET SDK..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/status.mjs\"",
            "timeout": 30,
            "statusMessage": "Building platform status dashboard..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/fleet-heartbeat.mjs\"",
            "timeout": 60,
            "statusMessage": "Fleet heartbeat — contract drift + health..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/mempalace_hook.py\" --hook stop --harness claude-code",
            "timeout": 60,
            "statusMessage": "Saving memories to MemPalace..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/mempalace_hook.py\" --hook precompact --harness claude-code",
            "timeout": 60,
            "statusMessage": "Emergency save to MemPalace before compaction..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "mcp__local-fleet__fleet_ps",
      "mcp__local-fleet__fleet_inspect",
      "mcp__local-fleet__fleet_logs"
    ]
  }
}
