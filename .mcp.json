{
  "mcpServers": {
    "arcadedb": {
      "type": "http",
      "url": "${ARCADEDB_MCP_URL:-http://localhost:2480/api/v1/mcp}",
      "headers": {
        "Authorization": "Bearer ${ARCADEDB_MCP_TOKEN}"
      }
    },
    "local-fleet": {
      "type": "http",
      "url": "${LOCAL_FLEET_MCP_URL:-http://127.0.0.1:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${LOCAL_FLEET_MCP_TOKEN}"
      }
    }
  }
}
