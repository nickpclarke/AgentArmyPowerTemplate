# Optional local overrides for Arcade Cockpit.
# Copy to .env for local use. The .env file is ignored by git.

PORT=8787
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=PlayWithData2026!
ARCADEDB_DATABASE=knowledge

# Keep false for normal cockpit use. Set true only when you want the query
# console to allow INSERT/UPDATE/DELETE/DDL commands.
ARCADEDB_ALLOW_MUTATION=false
