{
  "$comment": "One-way sync: hub (AgentArmy) -> spoke repos. Hub is the source of truth for the Claude Code microVM helper surface. Edit `spokes` to add a repo. Edit `paths` to change what syncs. `deny` is a hard safety net enforced even if a path is added by mistake.",
  "owner": "nickpclarke",
  "source_repo": "nickpclarke/AgentArmy",
  "branch": "chore/agentarmy-helper-sync",
  "spokes": [
    "frontend-core",
    "backend-core",
    "middle-core"
  ],
  "paths": [
    "AGENTS.md",
    ".github/ISSUE_TEMPLATE/epic-handoff.md",
    ".claude/agents",
    ".claude/commands",
    ".claude/agent-schema.json",
    ".claude/settings.json",
    "scripts/mempalace_hook.py",
    "scripts/mempalace-hook.ps1",
    "scripts/board_commands.py",
    "scripts/onboarding-check.ps1",
    "tools/status.mjs"
  ],
  "deny": [
    "CLAUDE.md",
    "settings.local.json",
    "settings.local.example.json",
    ".claude/worktrees",
    ".env",
    "*.local.json",
    "credentials.json"
  ]
}
